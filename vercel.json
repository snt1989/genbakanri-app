{
  "crons": [
    {
      "path": "/api/works-cron",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/config?snscron=1",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/config.js": {
      "maxDuration": 60
    }
  },
  "buildCommand": "node scripts/check.js",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    }
  ]
}